{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ldxp-cf-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/go/open-store",
      "/catalog",
      "/catalog/*",
      "/sitemap.xml",
      "/sitemap-shops.xml",
      "/sitemap-products.xml",
      "/llms.txt",
      "/llms-full.txt"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ldxp-demo-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SYNC_BATCH_SIZE": "3",
    "STALE_DAYS_THRESHOLD": "30",
    "AUTO_SYNC_ENABLED": "false"
  },
  "routes": [],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "workers_dev": false,
  "preview_urls": false
}
