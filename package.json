{
  "name": "ldxp-cf-demo",
  "version": "0.1.0",
  "private": true,
  "description": "PRISM Parity (棱镜比价) — Open-source AI subscription & digital goods multi-store price comparison engine on Cloudflare Workers, D1, and Miniflare.",
  "homepage": "https://parity.sirhao.top",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sirhap/prism-price.git"
  },
  "keywords": [
    "price-comparison",
    "ai-subscription",
    "chatgpt",
    "codex",
    "claude",
    "gemini",
    "deepseek",
    "cloudflare-workers",
    "cloudflare-d1",
    "miniflare",
    "typescript",
    "i18n",
    "seo",
    "llms-txt",
    "geo"
  ],
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply ldxp-demo-db --local",
    "push": "node scripts/push-sync.mjs",
    "sync:upstream": "node scripts/sync-from-qizhang.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:integration-codes": "node scripts/audit-integration-codes.mjs",
    "sync:local": "node scripts/local-sync.mjs",
    "test:sync": "node --test tests/*.node-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.99.0"
  }
}
