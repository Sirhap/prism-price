[Unit]
Description=LDXP scheduled collector
Requires=ldxp-cf-demo.service
After=ldxp-cf-demo.service

[Service]
Type=oneshot
User=ldxp
Group=ldxp
WorkingDirectory=/opt/ldxp-cf-demo/current
EnvironmentFile=/etc/ldxp-cf-demo.env
ExecStartPre=/usr/local/bin/node deploy/huoshan/wait-ready.mjs
ExecStart=/usr/local/bin/node deploy/huoshan/cron.mjs
TimeoutStartSec=12min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
