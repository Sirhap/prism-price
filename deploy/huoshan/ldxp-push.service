[Unit]
Description=LDXP domestic shop push collector
Requires=ldxp-cf-demo.service
After=ldxp-cf-demo.service

[Service]
Type=oneshot
User=ldxp
Group=ldxp
WorkingDirectory=/opt/ldxp-cf-demo/current
EnvironmentFile=/etc/ldxp-cf-demo.env
ExecStartPre=/usr/local/bin/node deploy/huoshan/wait-ready.mjs
ExecStart=/usr/local/bin/node scripts/push-sync.mjs --concurrency=2
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
